# Copy to .env and adjust. Real environment variables override this file.
# GroqCloud generation; keep the API key private.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local embeddings (the model is downloaded from Hugging Face on first startup).
EMBEDDING_MODEL=BAAI/bge-m3

# Legacy /api/health compatibility only; not used for embeddings or generation.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
CHROMA_DB_PATH=storage/chroma_db

# --- Optional extras (defaults shown) ---
# Minimum relevance (1 - cosine distance, 0..1) a chunk needs to be used as context.
# Below it the assistant answers "not enough information" without calling the LLM.
# Not tuned on real BGE-M3 scores: adjust after trying your own questions.
MIN_RELEVANCE_SCORE=0.30
COLLECTION_NAME=hr_documents
LOG_LEVEL=INFO

# Local CPU reranking. Download the model once before enabling this option.
RERANKER_ENABLED=false

# --- Web API (Week 2) ---
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins allowed to call the API (comma separated). Add your Netlify URL for remote hosting.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Administrator key that unlocks employee data (CSV files): searching, listing and uploading.
# Leave EMPTY to keep employee data completely disabled (recommended). Minimum 12 characters.
ADMIN_API_KEY=
MAX_UPLOAD_MB=25
# true (default) = every upload (PDF/DOCX too) needs the admin key, so nobody can change the knowledge base
# anonymously. Set false ONLY for a private test on your own computer.
UPLOADS_REQUIRE_ADMIN=true
# How many previous question/answer pairs of a conversation are used to understand follow-up questions (0 = off).
# Kept in server memory only; lost on restart.
HISTORY_TURNS=4
CONVERSATION_TTL_S=3600
MAX_CONCURRENT_CHATS=2
